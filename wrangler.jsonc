{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "japanese-notes",
  // Login credentials are managed in Cloudflare Variables and Secrets.
  "keep_vars": true,
  "main": "worker/index.ts",
  "compatibility_date": "2025-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "japanese-notes-db",
      // Replace with the ID of your Cloudflare D1 database before deploying.
      "database_id": "0e294f52-f0d2-4f44-94bd-220fd5bf55d6",
      "migrations_dir": "migrations",
    },
  ],
  "observability": { "enabled": true },
}
